# These variables must be exported or configured in the hosting environment.
# Local development does not need any values. .env is not loaded automatically.
OKK_ENV=production
OKK_ORIGIN=https://your-domain.example
OKK_DATA_DIR=/var/lib/okk
PORT=3000
# Optional: create the first admin when the database has no administrator.
# Set both in Render Environment. Password must contain at least 12 characters.
# OKK_ADMIN_USERNAME=
# OKK_ADMIN_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
